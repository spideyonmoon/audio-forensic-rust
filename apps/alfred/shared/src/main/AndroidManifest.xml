<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <service android:name="dev.alfred.shared.JobService" android:exported="false"
            android:foregroundServiceType="specialUse|mediaProcessing">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Offline audio analysis explicitly requested by the visible user" />
        </service>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.results"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/result_share_paths" />
        </provider>
    </application>
</manifest>
